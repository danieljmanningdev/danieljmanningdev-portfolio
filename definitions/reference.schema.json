{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Reference",
  "description": "Describes a relationship to a design, implementation, document, test, research source, or other resource.",

  "type": "object",

  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "figma",
        "repository",
        "implementation",
        "documentation",
        "research",
        "issue",
        "test",
        "external",
        "other"
      ]
    },

    "label": {
      "type": "string",
      "minLength": 1
    },

    "url": {
      "type": "string",
      "format": "uri-reference"
    },

    "path": {
      "type": "string"
    },

    "id": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "relationship": {
      "type": "string",
      "enum": [
        "implements",
        "documents",
        "supports",
        "tests",
        "designs",
        "depends-on",
        "related-to",
        "supersedes"
      ]
    }
  },

  "required": [
    "type",
    "label"
  ],

  "additionalProperties": false
}