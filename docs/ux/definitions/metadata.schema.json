{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Metadata",
  "description": "Describes common metadata for UX specification objects such as screens, components, flows, and decisions.",

  "type": "object",

  "properties": {
    "createdAt": {
      "type": "string",
      "format": "date"
    },

    "updatedAt": {
      "type": "string",
      "format": "date"
    },

    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "implemented",
        "deprecated",
        "archived"
      ]
    },

    "owner": {
      "type": "string",
      "minLength": 1
    },

    "contributors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },

    "project": {
      "type": "string",
      "minLength": 1
    },

    "feature": {
      "type": "string",
      "pattern": "^FEAT-[A-Z0-9-]+$"
    },

    "notes": {
      "type": "string"
    }
  },

  "additionalProperties": false
}