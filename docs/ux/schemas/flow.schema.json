{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "UX Flow",
  "description": "Describes a user or system flow across screens, states, and decisions.",

  "type": "object",

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FLOW-[A-Z0-9-]+$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "purpose": {
      "type": "string",
      "minLength": 1
    },

    "status": {
      "type": "string",
      "enum": [
        "concept",
        "draft",
        "approved",
        "implemented",
        "deprecated"
      ]
    },

    "entryPoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SCR-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },

    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },

    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },

    "decisions": {
      "type": "array",
      "items": {
        "$ref": "../definitions/decision.schema.json"
      }
    },

    "references": {
      "type": "array",
      "items": {
        "$ref": "../definitions/reference.schema.json"
      }
    }
  },

  "required": [
    "id",
    "name",
    "purpose",
    "steps"
  ],

  "additionalProperties": false,

  "$defs": {
    "step": {
      "type": "object",

      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },

        "type": {
          "type": "string",
          "enum": [
            "screen",
            "user-action",
            "system-action",
            "decision",
            "success",
            "failure"
          ]
        },

        "screen": {
          "type": "string",
          "pattern": "^SCR-[A-Z0-9-]+$"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string"
        }
      },

      "required": [
        "id",
        "type",
        "name"
      ],

      "additionalProperties": false
    },

    "transition": {
      "type": "object",

      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },

        "to": {
          "type": "string",
          "minLength": 1
        },

        "trigger": {
          "type": "string"
        },

        "condition": {
          "type": "string"
        },

        "description": {
          "type": "string"
        }
      },

      "required": [
        "from",
        "to"
      ],

      "additionalProperties": false
    }
  }
}