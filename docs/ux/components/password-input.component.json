{
  "id": "CMP-PASSWORD-INPUT",
  "name": "Password Input",
  "purpose": "Collect a password without displaying its value as plain text.",
  "type": "input",
  "status": "implemented",
  "content": {
    "label": {
      "value": "Password",
      "required": true
    },
    "placeholder": {
      "value": "Your password"
    }
  },
  "states": [
    {
      "name": "Default",
      "type": "default"
    },
    {
      "name": "Hover",
      "type": "hover",
      "trigger": "A pointing device is positioned over the input."
    },
    {
      "name": "Focus",
      "type": "focus",
      "trigger": "The input receives focus."
    },
    {
      "name": "Missing password",
      "type": "error",
      "trigger": "The required password value is empty."
    }
  ],
  "accessibility": {
    "standard": "WCAG-2.2-AA",
    "semantics": {
      "element": "input",
      "label": "Password"
    },
    "keyboard": {
      "accessible": true
    },
    "focus": {
      "visible": true
    },
    "errors": {
      "identifiedInText": true,
      "associatedWithField": true
    },
    "colour": {
      "notColourOnly": true
    }
  },
  "properties": [
    {
      "name": "type",
      "type": "enum",
      "required": true,
      "allowedValues": [
        "password"
      ]
    },
    {
      "name": "autocomplete",
      "type": "enum",
      "required": true,
      "allowedValues": [
        "current-password"
      ]
    },
    {
      "name": "required",
      "type": "boolean",
      "required": true
    }
  ],
  "implementation": {
    "partial": true,
    "htmx": false,
    "selectors": [
      "input[type=\"password\"]",
      ".auth-field__input"
    ],
    "stylesheets": [
      "web/static/css/vanilla/admin.css"
    ]
  }
}
