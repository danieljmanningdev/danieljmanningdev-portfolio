{
  "id": "CMP-WORKSPACE-DETAIL",
  "name": "Workspace Record Detail",
  "purpose": "Present one client, project or contract with its relationships, status and available actions.",
  "type": "custom",
  "status": "implemented",
  "states": [
    {
      "name": "Default",
      "type": "default"
    },
    {
      "name": "Record not found",
