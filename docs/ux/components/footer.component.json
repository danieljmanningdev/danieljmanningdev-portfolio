{
  "id": "CMP-FOOTER",
  "name": "Public Footer",
  "purpose": "Close public pages with a clear contact action, selected navigation and location context.",
  "type": "navigation",
  "status": "implemented",
  "states": [
    {
      "name": "Default",
      "type": "default"
    }
  ],
  "accessibility": {
    "standard": "WCAG-2.2-AA",
    "semantics": {
      "element": "footer"
    },
    "keyboard": {
      "accessible": true
    },
    "focus": {
      "visible": true
    },
    "screenReader": {
      "supported": true,
      "decorativeContentHidden": true
    },
    "colour": {
      "notColourOnly": true
    }
  },
  "responsive": {
    "strategy": "fluid",
    "inputModes": [
      "mouse",
      "keyboard",
      "touch"
    ]
  },
  "implementation": {
    "template": "web/templates/components/footer.html",
    "partial": true,
    "htmx": false,
    "selectors": [
      ".site-footer",
      ".footer-cta",
      ".footer-links"
    ],
    "stylesheets": [
      "web/static/css/vanilla/shell.css",
      "web/static/css/vanilla/components.css"
    ]
  }
}
