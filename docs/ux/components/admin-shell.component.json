{
  "id": "CMP-ADMIN-SHELL",
  "name": "Authenticated Workspace Shell",
  "purpose": "Provide the no-indexed authenticated layout, skip link, request progress, workspace navigation and footer.",
  "type": "custom",
  "status": "implemented",
  "states": [
    {
      "name": "Default",
      "type": "default"
    },
    {
      "name": "HTMX request in progress",
      "type": "loading",
      "trigger": "An HTMX-enhanced workspace request is active."
    }
  ],
  "accessibility": {
    "standard": "WCAG-2.2-AA",
    "semantics": {
      "element": "body"
    },
    "keyboard": {
      "accessible": true
    },
    "focus": {
      "visible": true
    },
    "screenReader": {
      "supported": true,
      "decorativeContentHidden": true
    },
    "motion": {
      "hasMotion": true,
      "reducedMotionSupported": true,
      "essential": false
    },
    "zoomAndReflow": {
      "supportsZoom": true,
      "supportsTextResize": true,
      "supportsReflow": true,
      "horizontalScrollingRequired": false
    }
  },
  "implementation": {
    "template": "web/templates/layouts/admin-base.html",
    "partial": false,
    "htmx": true,
    "selectors": [
      ".admin-shell",
      ".admin-canvas",
      "#page-progress"
    ],
    "stylesheets": [
      "web/static/css/vanilla/main.css",
      "web/static/css/vanilla/admin.css",
      "web/static/css/vanilla/admin-pages.css",
      "web/static/css/vanilla/admin-special.css",
      "web/static/css/vanilla/admin-polish.css"
    ],
    "scripts": [
      "web/static/scripts/min.htmx.js"
    ]
  },
  "decisions": [
    {
      "id": "UXD-ADMIN-SHELL-001",
      "decision": "Use a dedicated workspace shell rather than the public site shell.",
      "reason": "The private product needs task-focused navigation and must remain excluded from search indexing.",
      "status": "accepted"
    }
  ]
}
