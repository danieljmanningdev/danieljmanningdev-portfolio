{
  "id": "SCR-ADMIN-CLIENTS-EDIT",
  "name": "Edit Client",
  "purpose": "Update an existing client's contact details, status and notes.",
  "status": "implemented",
  "components": [
    "CMP-ADMIN-SHELL",
    "CMP-ADMIN-HEADER",
    "CMP-ADMIN-FOOTER",
    "CMP-WORKSPACE-FORM",
    "CMP-STATUS-INDICATOR"
  ],
  "states": [
    {
      "name": "Client form",
      "type": "default"
    },
    {
      "name": "Validation error",
      "type": "error",
      "trigger": "Submitted client values fail validation."
    },
    {
      "name": "Client not found",
      "type": "not-found",
      "trigger": "The requested client ID does not exist."
    },
    {
      "name": "Update failed",
      "type": "error",
      "trigger": "The client record cannot be updated."
    }
  ],
  "handler": "(*clients.ClientsHandler).editClient",
  "route": "/dashboard/clients/{id}/edit",
  "template": "web/templates/pages/admin/clients/edit.html",
  "layout": "web/templates/layouts/admin-base.html",
  "flows": [
    "FLOW-CLIENT-MANAGEMENT"
  ],
  "references": [
    {
      "type": "implementation",
      "label": "Edit Client handler",
      "path": "internal/clients/pages.go",
      "relationship": "implements"
    }
  ],
  "implementation": {
    "method": "GET",
    "serverRendered": true,
    "javascriptRequired": false,
    "htmx": false,
    "middleware": [
      "NoIndex",
      "NoStore",
      "RequireAdmin"
    ],
    "dataSources": [
      "repository.ClientRepository.GetByID"
    ]
  }
}
