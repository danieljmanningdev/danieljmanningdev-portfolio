  "template": "web/templates/pages/public/404.html",
  "layout": "web/templates/layouts/base.html",
  "references": [
    {
      "type": "implementation",
      "label": "Not-found renderer",
      "path": "internal/http/not_found.go",
      "relationship": "implements"
    }
